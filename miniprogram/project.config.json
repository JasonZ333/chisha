{
  "description": "微信开发者工具项目配置。AppID 请填你自己的小程序 AppID（或在工具里用测试号）。",
  "projectname": "chisha-miniprogram",
  "compileType": "miniprogram",
  "libVersion": "3.5.0",
  "miniprogramRoot": "./",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": false,
    "minifyWXML": false,
    "ignoreDevUnusedFiles": false,
    "ignoreUploadUnusedFiles": true
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" }
    ]
  }
}