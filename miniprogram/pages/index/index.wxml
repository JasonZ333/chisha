<view class="page">
  <!-- 顶部：标题 + 设置（对齐 Windows 端 AppBar）-->
  <view class="topbar">
    <text class="topbar-title">吃啥</text>
    <view class="topbar-gear" hover-class="tap" bindtap="onOpenSettings">
      <image class="icon-gear" src="/images/icons/icon_settings.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 首屏：图标 + 大标题 + 副标题 -->
  <view class="hero">
    <image class="hero-icon" src="/images/icons/icon_bowl.png" mode="aspectFit" />
    <view class="hero-title">今天吃什么？</view>
    <view class="hero-sub">别纠结了，交给命运</view>
  </view>

  <!-- 三个卡片式按钮：与 lib/pages/home_page.dart 的 _BigButton 结构一致 -->
  <!-- 第一张：文案只有「开始」两个字，不带任何副标题 -->
  <view class="card-btn card-btn-filled" hover-class="card-tap" bindtap="onRandomAny">
    <image class="card-icon" src="/images/icons/icon_shuffle_white.png" mode="aspectFit" />
    <view class="card-text">
      <view class="card-title on-filled">开始</view>
    </view>
    <image class="card-arrow" src="/images/icons/icon_chevron_white.png" mode="aspectFit" />
  </view>

  <picker mode="selector" range="{{tierLabels}}" bindchange="onPickTier">
    <view class="card-btn" hover-class="card-tap">
      <image class="card-icon" src="/images/icons/icon_tune.png" mode="aspectFit" />
      <view class="card-text">
        <view class="card-title">分价位随机</view>
        <view class="card-sub">先选 10 ~ 100 元档位，再随机一道</view>
      </view>
      <image class="card-arrow" src="/images/icons/icon_chevron.png" mode="aspectFit" />
    </view>
  </picker>

  <view class="card-btn" hover-class="card-tap" bindtap="onRandomNearby">
    <image class="card-icon" src="/images/icons/icon_location.png" mode="aspectFit" />
    <view class="card-text">
      <view class="card-title">附近美食随机</view>
    </view>
    <image class="card-arrow" src="/images/icons/icon_chevron.png" mode="aspectFit" />
  </view>

  <!-- 随机结果：屏幕正中的弹窗（对齐桌面端的 AlertDialog）-->
  <view class="modal-wrap" wx:if="{{hasDish}}">
    <view class="modal-mask" bindtap="onCloseDish"></view>
    <view class="modal-card">
      <image class="dish-img" src="/images/dishes/{{dish.image}}" mode="aspectFill" />
      <view class="dish-body">
        <view class="dish-name">{{dish.name}}</view>
        <view class="dish-meta">
          <text class="price">{{dish.price}} 元</text>
          <text class="tag" wx:if="{{tierLabel}}">{{tierLabel}}</text>
          <text class="tag">{{dish.category}}</text>
        </view>
        <view class="actions">
          <button class="btn btn-ghost" bindtap="onReroll">再随机一个</button>
          <button class="btn btn-takeout" bindtap="onTakeout">点外卖</button>
        </view>
        <view class="modal-close" bindtap="onCloseDish">关闭</view>
      </view>
    </view>
  </view>

  <!-- 附近美食结果：同样是屏幕正中的弹窗 -->
  <view class="modal-wrap" wx:if="{{nearbyBusy || nearby}}">
    <view class="modal-mask" bindtap="onNearbyClose"></view>
    <view class="modal-card">
      <view class="nearby-head">
        <image class="nearby-head-icon" src="/images/icons/icon_location.png" mode="aspectFit" />
        <text class="nearby-head-text">{{nearbyBusy ? nearbyStatus : '附近美食'}}</text>
      </view>

      <view class="nearby-body" wx:if="{{nearby}}">
        <view class="nearby-title">{{nearby.title}}</view>
        <view class="dish-meta">
          <text class="tag" wx:if="{{nearbyDistance}}">{{nearbyDistance}}</text>
          <text class="tag">{{nearby.category}}</text>
        </view>
        <view class="nearby-address" wx:if="{{nearby.address}}">{{nearby.address}}</view>
        <view class="actions">
          <button class="btn btn-ghost" bindtap="onNearbyReroll">换一家</button>
          <button class="btn btn-takeout" bindtap="onNearbyNavigate">导航过去</button>
        </view>
        <view class="modal-close" bindtap="onNearbyClose">关闭</view>
      </view>
    </view>
  </view>

  <!-- 点外卖：平台选择页（保持底部弹出，与需求里的选择页一致）-->
  <view class="mask" wx:if="{{showTakeout}}" bindtap="onTakeoutCancel"></view>
  <view class="sheet" wx:if="{{showTakeout}}">
    <view class="sheet-title">去点「{{dish.name}}」的外卖</view>
    <view class="sheet-note">{{copied ? '菜名已复制，选好平台直接粘贴搜索' : '复制失败，请手动记下菜名'}}</view>
    <view
      class="sheet-item"
      wx:for="{{platforms}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTakeoutPick"
    >
      <text class="sheet-item-name">{{item.name}}</text>
      <text class="sheet-item-tag" wx:if="{{!item.canJump}}">需在 App 内搜索</text>
    </view>
    <view class="sheet-cancel" bindtap="onTakeoutCancel">取消</view>
  </view>
</view>
