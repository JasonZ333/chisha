/* 首页样式：与 lib/pages/home_page.dart 的桌面端布局对齐 */

/* ── 顶部：设置入口（标题「吃啥」已删除）────────── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 8rpx 0 0;
}

.topbar-gear {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.icon-gear {
  width: 44rpx;
  height: 44rpx;
}

.tap {
  background: rgba(139, 74, 43, 0.10);
}

/* ── 首屏 ─────────────────────────────────────── */
.hero {
  padding: 56rpx 0 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-icon {
  width: 144rpx;
  height: 144rpx;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #2B2320;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #9C8A80;
}

/* ── 卡片式按钮 ──────────────────────────────────
   三张卡片高度必须一致：以内容最高的「分价位随机」（标题+副标题，
   约 152rpx）为准设一个下限高度，不足的卡片自动撑到同一高度；
   内容用 align-items:center 垂直居中，看起来仍然居中不空。 */
.card-btn {
  display: flex;
  align-items: center;
  min-height: 156rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 34rpx 36rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E6D5C8;
}

.card-btn-filled {
  background: #8B4A2B;
  border-color: #8B4A2B;
  box-shadow: 0 8rpx 28rpx rgba(139, 74, 43, 0.22);
}

.card-tap {
  opacity: 0.82;
}

.card-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.card-text {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2B2320;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9C8A80;
}

/* 实心卡片上的文字反色 */
.on-filled {
  color: #FFF8F2;
}

.card-arrow {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ── 居中结果弹窗 ───────────────────────────────
   桌面端的结果是屏幕正中的 AlertDialog（showDialog + Center），
   所以小程序这边也用「整屏遮罩 + 垂直水平都居中」的弹窗，
   而不是把卡片顺着页面流往下排。 */
.modal-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 10;
}

.modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.modal-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.28);
}

/* ── 翻牌动效（方案 B：抽签 → 翻牌 → 光爆）──────────
   纯 WXSS 实现：3D 翻转用 rotateY + preserve-3d + backface-visibility，
   背后的光用 radial-gradient + 圆环，不加依赖、不加包体。 */

.flip-stage {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 620rpx;
  /* 透视距离：值越小透视越夸张 */
  perspective: 1600rpx;
}

.flip-inner {
  position: relative;
  transform-style: preserve-3d;
  /* 正面朝前；抽签阶段由 .is-back 转 180° 露出背面 */
  transform: rotateY(0deg);
  transition: transform 180ms cubic-bezier(0.34, 0.1, 0.28, 1);
}

.flip-stage.is-back .flip-inner {
  transform: rotateY(180deg);
}

.flip-face {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.28);
}

/* 正面在文档流里，负责撑开高度 */
.flip-front {
  position: relative;
  background: #ffffff;
}

/* 背面绝对定位，铺满正面撑出来的盒子 */
.flip-back {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transform: rotateY(180deg);
  background: linear-gradient(160deg, #8b4a2b 0%, #6c3720 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.flip-back-q {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff8f2;
  opacity: 0.92;
}

.flip-back-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #ffe4cf;
  opacity: 0.85;
  letter-spacing: 2rpx;
}

/* ── 卡片背后的光 ─────────────────────────────── */
.fx {
  /* 注意：这里必须是「铺满舞台」的实体尺寸。
     实测 0×0 的元素在微信 webview 里不会绘制它的子元素，光效会整个消失。 */
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.fx-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1100rpx;
  height: 1100rpx;
  margin-left: -550rpx;
  margin-top: -550rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 214, 150, 0.95) 0%,
    rgba(255, 176, 84, 0.6) 30%,
    rgba(255, 140, 50, 0) 70%
  );
  opacity: 0;
  transform: scale(0.5);
}

.fx-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 620rpx;
  height: 620rpx;
  margin-left: -310rpx;
  margin-top: -310rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 198, 122, 0.95);
  opacity: 0;
}

.fx-ring-late {
  animation-delay: 110ms;
}

/* 揭晓时才播光效：切到 .is-front 类会重新触发动画（再随机一次也会重播） */
.flip-stage.is-front .fx-glow {
  animation: glow-bloom 620ms ease-out both;
}

.flip-stage.is-front .fx-ring {
  animation: ring-burst 520ms ease-out both;
}

@keyframes glow-bloom {
  0% {
    opacity: 0;
    transform: scale(0.55);
  }
  35% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0;
    transform: scale(1.45);
  }
}

@keyframes ring-burst {
  0% {
    opacity: 0.95;
    transform: scale(0.42);
  }
  100% {
    opacity: 0;
    transform: scale(1.35);
  }
}

.modal-close {
  margin-top: 18rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8A7A70;
}

/* ── 菜品结果 ─────────────────────────────────── */
.dish-img {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #F3E7DC;
}

.dish-body {
  padding: 32rpx;
}

.dish-name {
  font-size: 44rpx;
  font-weight: 700;
}

.dish-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #8B4A2B;
  margin-right: 16rpx;
}

.tag {
  margin-right: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: #F7E9DE;
  color: #8B4A2B;
  font-size: 24rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
}

/* 按钮：用 flex 双向居中。
   小程序的 <button> 自带 line-height 与左右 padding，靠「line-height = height」
   这种写法会让文字偏下；改成 flex 居中后与 padding、字号都无关，稳定居中。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 1.2;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-ghost {
  flex: 1;
  margin: 0 12rpx 0 0;
  background: #F3E7DC;
  color: #6B4A36;
}

.btn-takeout {
  flex: 1;
  margin: 0 0 0 12rpx;
  background: #E8A33D;
  color: #FFFFFF;
}

/* ── 附近美食结果 ─────────────────────────────── */
.nearby-head {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid #F6EEE7;
  background: #FBF3EC;
}

.nearby-head-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.nearby-head-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.nearby-head-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #8B4A2B;
}

.nearby-head-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A08878;
  /* 地区名可能很长，超出时省略，避免把右侧按钮挤变形 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nearby-change {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  background: #F2E3D7;
  color: #8B4A2B;
  font-size: 28rpx;
  font-weight: 600;
}

.nearby-body {
  padding: 32rpx;
}

/* ── 改地点弹窗 ───────────────────────────────── */
.picker-head {
  padding: 32rpx 32rpx 8rpx;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2B2320;
}

.picker-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9C8A80;
}

.picker-body {
  padding: 20rpx 32rpx 8rpx;
}

.picker-input {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #FBF3EC;
  border: 2rpx solid #E6D5C8;
  font-size: 30rpx;
  color: #2B2320;
}

.picker-hint {
  padding: 24rpx 4rpx;
  font-size: 24rpx;
  color: #A08878;
  text-align: center;
}

.picker-list {
  max-height: 420rpx;
  margin-top: 16rpx;
}

.picker-item {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #F6EEE7;
  display: flex;
  flex-direction: column;
}

.picker-item-title {
  font-size: 28rpx;
  color: #2B2320;
  font-weight: 600;
}

.picker-item-addr {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9C8A80;
}

.nearby-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2B2320;
}

.nearby-address {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #9C8A80;
  line-height: 1.6;
}

/* ── 点外卖：底部选择页（在结果弹窗之上）────────── */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-title {
  padding: 36rpx 32rpx 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2320;
}

.sheet-note {
  padding: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: #9C8A80;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  border-top: 2rpx solid #F1E7DF;
  font-size: 32rpx;
  color: #2B2320;
}

.sheet-item-name {
  font-weight: 600;
}

.sheet-item-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #B9A79C;
}

.sheet-cancel {
  margin-top: 16rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-top: 16rpx solid #F7F1EB;
  font-size: 32rpx;
  color: #8A7A70;
}
