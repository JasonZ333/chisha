/* 「吃啥」小程序全局样式 —— 配色沿用桌面版 */
page {
  background: #FBF3EC;
  color: #2B2320;
  font-size: 30rpx;
}

.page {
  padding: 40rpx 32rpx 60rpx;
}

/* ── 顶部标题 ───────────────────────────── */
.hero {
  padding: 40rpx 0 48rpx;
}

.hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  color: #8B4A2B;
  letter-spacing: 8rpx;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #9C8A80;
}

/* ── 按钮 ──────────────────────────────── */
.btn {
  margin: 0 0 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #8B4A2B;
  color: #FFF8F2;
}

.btn-outline {
  background: #FFFFFF;
  color: #8B4A2B;
  border: 2rpx solid #E6D5C8;
}

.btn-ghost {
  flex: 1;
  margin: 0 12rpx 0 0;
  background: #F3E7DC;
  color: #6B4A36;
}
